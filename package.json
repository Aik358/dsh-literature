{
  "name": "@a9i5k4/dsh-literature",
  "version": "0.2.3",
  "description": "DSH Literature 文献侧窗：在 DeepSeek Harness 侧边栏识别 DOI/arXiv/标题、抓取元数据与全文、写入本地文献库或导出目录，并提供内置 PDF 阅读器（缩放/翻页/目录/搜索/高亮/笔记）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test-host.mjs",
    "check:client": "node scripts/check-client.mjs && node scripts/check-apply.mjs",
    "prepublishOnly": "node build.mjs && node scripts/smoke.mjs && node scripts/check-client.mjs && node scripts/check-apply.mjs && node scripts/test-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "literature",
    "paper",
    "plugin",
    "pdf",
    "reader",
    "reference",
    "zotero",
    "citations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aik358/dsh-literature.git"
  },
  "bugs": {
    "url": "https://github.com/Aik358/dsh-literature/issues"
  },
  "homepage": "https://github.com/Aik358/dsh-literature#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT"
}
